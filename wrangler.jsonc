{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "produtos-scrap-odontojf-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-21",
  "workers_dev": true,
  "account_id": "9a9f4e5b0f7015bab8ca874ecd887339",
  "routes": [
    {
      "pattern": "odontoapi.wpatomic.com.br",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "odontojf-products-db",
      "database_id": "48a12199-a327-40da-9def-1f1f993cf00b"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "odontojf-products-media"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "SYNC_QUEUE",
        "queue": "odontojf-sync-queue"
      },
      {
        "binding": "SYNC_DLQ",
        "queue": "odontojf-sync-dlq"
      }
    ],
    "consumers": [
      {
        "queue": "odontojf-sync-queue",
        "max_batch_size": 5,
        "max_retries": 5,
        "dead_letter_queue": "odontojf-sync-dlq",
        "max_batch_timeout": 10,
        "max_concurrency": 10
      }
    ]
  },
  "vars": {
    "SCRAPE_BASE_URL": "https://dentalodontocirurgicajf.com.br",
    "SCRAPE_SITEMAP_PATH": "/api/sitemap/products",
    "SCRAPE_USER_AGENT": "Mozilla/5.0 (compatible; OdontoJfSync/1.0; +https://odontoapi.wpatomic.com.br)",
    "ERP_BASE_URL": "http://45.227.82.180:8082/ecommerceapi/v1",
    // Effective target in production (confirmed via GET /version). The old
    // value here pointed at odonto.wpatomic.com.br — deploying with that set
    // would have repointed the push at the wrong store, since vars in this
    // file overwrite whatever is configured in the dashboard.
    "WOO_BASE_URL": "https://dentalodontocirurgica.com.br",
    "REBUILD_INTERVAL_HOURS": "24",
    "DRAIN_BATCH_SIZE": "20",
    "REQUEST_TIMEOUT_MS": "15000",
    "LOG_LEVEL": "INFO",
    "MEDIA_PUBLIC_BASE_URL": "https://media.odontoapi.wpatomic.com.br",
    "AUTO_ENQUEUE_ERP": "1",
    "AUTO_ENQUEUE_MERGE": "1",
    // Gates that were only set in the dashboard, so they were missing here.
    // Values below match observed production behaviour (media runs and pushes
    // happen). CONFIRM against the dashboard before the first deploy — these
    // overwrite it. SCRAPE_AUTO_MIRROR is deliberately left unset: its default
    // when absent is already "on".
    "AUTO_ENQUEUE_MEDIA": "1",
    "WOO_PUSH_ENABLED": "1",
    "ERP_FILIAL_CODIGO": "1"
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
